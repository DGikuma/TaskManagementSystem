# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL (without trailing slash)
VITE_API_URL=http://localhost:5000/api

# API timeout in milliseconds
VITE_API_TIMEOUT=10000

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Application name
VITE_APP_NAME="Task Manager Pro"
VITE_APP_VERSION=1.0.0

# Default application language
VITE_APP_LANGUAGE=en

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable features (true/false)
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_OFFLINE_MODE=false
VITE_FEATURE_PUSH_NOTIFICATIONS=false

# ============================================
# UI/UX SETTINGS
# ============================================
# Default theme (light/dark/auto)
VITE_THEME=light

# Animation speed (fast/medium/slow)
VITE_ANIMATION_SPEED=medium

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Enable React dev tools in production (true/false)
VITE_ENABLE_DEV_TOOLS=false

# Mock API mode (true/false)
VITE_MOCK_API=false

# ============================================
# PERFORMANCE SETTINGS
# ============================================
# Enable performance monitoring (true/false)
VITE_PERFORMANCE_MONITORING=true

# Image optimization quality (0-100)
VITE_IMAGE_QUALITY=85

# ============================================
# SECURITY SETTINGS
# ============================================
# Enable security headers (true/false)
VITE_SECURITY_HEADERS=true

# Content Security Policy mode (strict/loose)
VITE_CSP_MODE=strict